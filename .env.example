AI_PROFILE=local_free
DATA_DIR=runtime
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:latest
EMBED_MODEL=nomic-embed-text:latest
VECTOR_STORE=auto
# http connects to an existing local Chroma server; embedded uses runtime/chroma.
CHROMA_MODE=http
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8082
# Cloud calls require BOTH consent gates. Leave disabled for free operation.
ALLOW_CLOUD=false
ALLOW_PAID=false
CLOUD_DATA_CONSENT=false
ALLOW_LOCAL_FALLBACK=false
CLOUD_API_KEY=
CLOUD_MODEL=
# hybrid supports an explicitly selected OpenRouter :free model only.
MAX_COST_USD=0
CLOUD_INPUT_USD_PER_MILLION=0
CLOUD_OUTPUT_USD_PER_MILLION=0
API_TOKEN=
REQUIRE_AUTH=true
PINECONE_API_KEY=
PINECONE_HOST=
PINECONE_DIMENSION=768
PINECONE_MAX_REQUEST_USD=0
MEM0_API_KEY=
MEM0_MAX_REQUEST_USD=0
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_URL=https://cloud.langfuse.com
LANGFUSE_MAX_REQUEST_USD=0
KEENABLE_API_KEY=
KEENABLE_MAX_REQUEST_USD=0
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MAX_REQUEST_USD=0
# Generate API_TOKEN with python -m scripts.configure_access before starting the API.
